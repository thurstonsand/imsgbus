#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

run_step() {
  local name="$1"
  shift
  local start="${SECONDS}"

  printf '\n==> %s\n' "${name}"
  "$@"
  printf '<== %s (%ss)\n' "${name}" "$((SECONDS - start))"
}

install_mise() {
  if [[ -x "${HOME}/.local/bin/mise" ]]; then
    return
  fi

  curl -fsSL https://mise.run | MISE_INSTALL_HELP=0 MISE_SELF_UPDATE_MINIMUM_RELEASE_AGE=3d sh
}

configure_mise_path() {
  local profile="${HOME}/.bash_profile"
  local marker='# imsgbus mise shims'

  touch "${profile}"
  if grep -Fqx "${marker}" "${profile}"; then
    return
  fi

  cat >>"${profile}" <<'EOF'

# imsgbus mise shims
case ":${PATH}:" in
  *":${HOME}/.local/bin:"*) ;;
  *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac
case ":${PATH}:" in
  *":${HOME}/.local/share/mise/shims:"*) ;;
  *) export PATH="${HOME}/.local/share/mise/shims:${PATH}" ;;
esac
EOF
}

install_toolchain() {
  mise trust --yes "${repo_root}/mise.toml"
  mise trust --yes "${repo_root}/mise.renovate.toml"
  mise install --yes --locked --jobs 8
  # lint:renovate runs Renovate from its own overlay env; install it now so lint doesn't.
  MISE_ENV=renovate mise install --yes --locked --jobs 8
}

install_dependencies() {
  mise run bootstrap
  go mod download
}

warm_build_cache() {
  # Compiling mattn/go-sqlite3's cgo takes over a minute; doing it here puts it in the snapshot
  # instead of every orb's first build, test or lint.
  go test -run '^$' ./... >/dev/null
}

run_step 'mise' install_mise
configure_mise_path
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH}"
run_step 'project toolchain' install_toolchain
run_step 'project dependencies' install_dependencies
run_step 'Go build cache' warm_build_cache

printf '\nOrb setup complete. Running imsgbus against Messages and release builds remain macOS-only.\n'
