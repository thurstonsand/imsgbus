{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+#/(?<depType>Config|Builtins)\\.pkl"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/{{{depType}}}.pkl"
    },
    {
      "description": "Homebrew/actions tags have four parts (2026.11.02.1), which the github-actions manager truncates to three and then cannot find, so this manager reads the full tag.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: Homebrew/actions/[^@\\s]+@(?:(?<currentDigest>[0-9a-f]{40}) # )?(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "Homebrew/actions",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The Homebrew/actions custom manager above owns these pins; the built-in manager would only raise its truncated-tag warning.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Homebrew/actions"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["Homebrew/actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "description": "imsgbus runs as an mxmain bridge, so a mautrix release can change the process it runs in: the config it upgrades, its database, and what bridgev2 expects of the connector. It lands on its own so its PR is reviewed against mautrix's changelog and the bridges mautrix updates alongside it",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["maunium.net/go/mautrix", "go.mau.fi/**"],
      "groupName": "mautrix",
      "groupSlug": "mautrix"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "uuid is feature-complete, not unmaintained",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/google/uuid"],
      "abandonmentThreshold": null
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk",
      "groupSlug": "hk"
    },
    {
      "description": "mise lock writes .mise/locks for mise.renovate.lock, and Renovate's mise manager regenerates it when it bumps that file. The npm manager would also bump the sidecar's package.json on its own, out of step with its aube-lock.yaml and the digest in mise.renovate.lock",
      "matchFileNames": [".mise/locks/**"],
      "enabled": false
    }
  ]
}
